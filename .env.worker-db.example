# Contract for the isolated media worker database identity.
# scripts/dev.ps1 creates .env.worker-db.local with a generated 256-bit secret.
# Production must inject an independently generated secret through its secret store.
SOUNDCONNECT_MEDIA_WORKER_POSTGRES_USERNAME=soundconnect_media_worker
SOUNDCONNECT_MEDIA_WORKER_POSTGRES_PASSWORD=replace-with-a-generated-256-bit-secret
