# Copy this API-only file to .env.local and replace all secret placeholders.
# .env.local is ignored by Git. Compose and scripts/dev.ps1 load it automatically.
# Never place SOUNDCONNECT_MEDIA_WORKER_* values here: dev.ps1 creates isolated,
# generated worker credential files from the two .env.worker-*.example contracts.

# Runtime profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SOUNDCONNECT_BACKEND_HOST_PORT=8080
SERVER_ADDRESS=0.0.0.0
SPRING_SHUTDOWN_TIMEOUT=30s

# PostgreSQL
SOUNDCONNECT_POSTGRES_DB=soundconnect
SOUNDCONNECT_POSTGRES_HOST_PORT=5433
SOUNDCONNECT_POSTGRES_URL=jdbc:postgresql://localhost:5433/soundconnect
SOUNDCONNECT_POSTGRES_USERNAME=soundconnect
SOUNDCONNECT_POSTGRES_PASSWORD=change-me
SOUNDCONNECT_POSTGRES_POOL_MAX_SIZE=10
SOUNDCONNECT_POSTGRES_POOL_MIN_IDLE=2
SOUNDCONNECT_POSTGRES_POOL_CONNECTION_TIMEOUT_MS=30000

# JWT (minimum 32 UTF-8 bytes; generate a unique random production value)
SOUNDCONNECT_JWT_SECRETKEY=replace-with-at-least-32-random-bytes
SOUNDCONNECT_JWT_EXTIME=86400000
SOUNDCONNECT_JWT_ISSUER=soundconnect-api

# Browser and WebSocket origins (comma-separated; never use * in production)
SOUNDCONNECT_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5000
APP_SHARE_BASE_URL=http://localhost:8080

# RabbitMQ. The broker must provide the rabbitmq_delayed_message_exchange plugin.
# Compose creates this non-guest application account for container-to-container access.
SOUNDCONNECT_RABBITMQ_HOST_PORT=5673
SOUNDCONNECT_RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5673
SPRING_RABBITMQ_USERNAME=soundconnect
SPRING_RABBITMQ_PASSWORD=change-me
SPRING_RABBITMQ_VIRTUAL_HOST=/
SPRING_RABBITMQ_CONNECTION_TIMEOUT=10s

# Redis
SOUNDCONNECT_REDIS_HOST_PORT=6379
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false
SPRING_DATA_REDIS_TIMEOUT=2s

# Authentication abuse protection (Redis-backed, fail-open if Redis is unavailable)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_KEY_PREFIX=soundconnect:auth-rate-limit
# Comma-separated ingress proxy CIDRs allowed to supply forwarding headers.
# Empty is the secure default for a directly exposed application.
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
# Choose exactly the header your trusted ingress sanitizes and appends.
# Supported: FORWARDED, X_FORWARDED_FOR
AUTH_RATE_LIMIT_FORWARDED_HEADER=FORWARDED
AUTH_RATE_LIMIT_LOGIN_LIMIT=10
AUTH_RATE_LIMIT_LOGIN_WINDOW=1m
AUTH_RATE_LIMIT_GOOGLE_LOGIN_LIMIT=10
AUTH_RATE_LIMIT_GOOGLE_LOGIN_WINDOW=1m
AUTH_RATE_LIMIT_REGISTER_LIMIT=5
AUTH_RATE_LIMIT_REGISTER_WINDOW=5m
AUTH_RATE_LIMIT_OTP_VERIFY_LIMIT=10
AUTH_RATE_LIMIT_OTP_VERIFY_WINDOW=5m
AUTH_RATE_LIMIT_OTP_RESEND_LIMIT=3
AUTH_RATE_LIMIT_OTP_RESEND_WINDOW=5m
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_LIMIT=3
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW=5m
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_LIMIT=10
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_WINDOW=5m
PASSWORD_RESET_MAIL_WORKER_THREADS=2
PASSWORD_RESET_MAIL_QUEUE_CAPACITY=100
PASSWORD_RESET_MAIL_SHUTDOWN_AWAIT_SECONDS=30

# Authenticated media upload abuse protection. Signed upload creation is
# fail-closed by default when Redis is unavailable; normal reads continue.
SOUNDCONNECT_MEDIA_UPLOAD_GUARD_ENABLED=true
SOUNDCONNECT_MEDIA_UPLOAD_GUARD_FAIL_OPEN=false
SOUNDCONNECT_MEDIA_UPLOAD_GUARD_KEY_PREFIX=soundconnect:media-upload
SOUNDCONNECT_MEDIA_UPLOAD_MAX_REQUESTS=20
SOUNDCONNECT_MEDIA_UPLOAD_MAX_BYTES=8000000000
SOUNDCONNECT_MEDIA_UPLOAD_WINDOW=1h
SOUNDCONNECT_MEDIA_UPLOAD_MAX_CONCURRENT=4
SOUNDCONNECT_MEDIA_UPLOAD_RESERVATION_TTL=30m
SOUNDCONNECT_MEDIA_UPLOAD_CLEANUP_ENABLED=true
SOUNDCONNECT_MEDIA_UPLOAD_STALE_AFTER=2h
SOUNDCONNECT_MEDIA_UPLOAD_CLEANUP_BATCH_SIZE=100
SOUNDCONNECT_MEDIA_UPLOAD_CLEANUP_WORKER_THREADS=4
SOUNDCONNECT_MEDIA_UPLOAD_CLEANUP_QUEUE_CAPACITY=200
SOUNDCONNECT_MEDIA_UPLOAD_CLEANUP_INITIAL_DELAY_MS=600000
SOUNDCONNECT_MEDIA_UPLOAD_CLEANUP_FIXED_DELAY_MS=900000
# Public browser/CDN cache is bounded so delete remains effective even when
# CloudFront invalidation is not configured or is temporarily unavailable.
SOUNDCONNECT_MEDIA_PUBLIC_CACHE_CONTROL=public, max-age=300, s-maxage=3600, stale-while-revalidate=60
S3_PUBLIC_CACHE_MAX_AGE_SECONDS=300
S3_SHARED_CACHE_MAX_AGE_SECONDS=3600
SOUNDCONNECT_MEDIA_UPLOAD_PRESIGN_CLOCK_SKEW=PT1M
SOUNDCONNECT_MEDIA_THUMBNAIL_MAX_DIMENSION=960
SOUNDCONNECT_MEDIA_IMAGE_MAX_SOURCE_PIXELS=60000000
SOUNDCONNECT_MEDIA_THUMBNAIL_JPEG_QUALITY=0.82
SOUNDCONNECT_MEDIA_THUMBNAIL_PROCESS_TIMEOUT_SECONDS=30
SOUNDCONNECT_MEDIA_IMAGE_VARIANT_WORKER_ENABLED=true
SOUNDCONNECT_MEDIA_THUMBNAIL_BACKFILL_ENABLED=true
SOUNDCONNECT_MEDIA_THUMBNAIL_BACKFILL_BATCH_SIZE=25
SOUNDCONNECT_MEDIA_THUMBNAIL_BACKFILL_INITIAL_DELAY=PT2M
SOUNDCONNECT_MEDIA_THUMBNAIL_BACKFILL_FIXED_DELAY=PT10M

# One-time password policy
SOUNDCONNECT_OTP_TTL_MINUTES=3
SOUNDCONNECT_OTP_LENGTH=6
SOUNDCONNECT_OTP_MAX_ATTEMPTS=5
SOUNDCONNECT_OTP_RESEND_COOLDOWN_SECONDS=30

# AWS S3 / compatible object storage
S3_BUCKET=soundconnect-media
# Must be a separate, non-CDN origin bucket used for PRIVATE/UNLISTED objects
# and every untrusted PUBLIC upload source under quarantine/. Configure a
# checked-in lifecycle rule expires only quarantine/ within 24h and aborts
# incomplete multipart uploads. Never broadly expire verified/ (live video source)
# or private-verified/ (live protected media). The runtime identity must be able
# to copy from this bucket to S3_BUCKET; clients receive signed PUT only here.
S3_PRIVATE_BUCKET=soundconnect-private-media
AWS_REGION=eu-central-1
# Optional override. When omitted, application.yml uses the current CloudFront URL.
# S3_CDN_BASE_URL=https://your-distribution.cloudfront.net
# Optional but recommended in production. Presence enables one tightly scoped
# /media/{assetId}/* invalidation after durable deletion; leave empty locally.
S3_CLOUDFRONT_DISTRIBUTION_ID=
S3_ENDPOINT=
S3_PATH_STYLE_ACCESS=false
S3_PROVIDER=s3
S3_UPLOAD_PRESIGN_EXPIRY_SECONDS=900
S3_DOWNLOAD_PRESIGN_EXPIRY_SECONDS=300
S3_ACL_PUBLIC_READ_ON_PUT=false
# Leave both empty to use the AWS default credentials provider chain (recommended).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# MailerSend
MAILERSEND_API_KEY=replace-me
MAILERSEND_SENDER_EMAIL=no-reply@example.com
MAILERSEND_SENDER_NAME=SoundConnect
MAILERSEND_CONNECT_TIMEOUT_MS=5000
MAILERSEND_READ_TIMEOUT_SECONDS=8

# Mail queue topology and retry policy
SOUNDCONNECT_MAIL_EXCHANGE=mail.exchange
SOUNDCONNECT_MAIL_ROUTING_KEY=mail.send
SOUNDCONNECT_MAIL_QUEUE=mail.queue
SOUNDCONNECT_MAIL_DLX=mail.dlx
SOUNDCONNECT_MAIL_DLQ=mail.queue.dlq
SOUNDCONNECT_MAIL_DELAYED_EXCHANGE=mail.delayed
SOUNDCONNECT_MAIL_TTL_MS=120000
SOUNDCONNECT_MAIL_LISTENER_CONCURRENCY=1-5
SOUNDCONNECT_MAIL_LISTENER_PREFETCH=10
SOUNDCONNECT_MAIL_IDEMPOTENCY_TTL_SECONDS=900
SOUNDCONNECT_MAIL_LOCK_TTL_SECONDS=300
SOUNDCONNECT_MAIL_CONFIRM_TIMEOUT_SECONDS=5
SOUNDCONNECT_MAIL_MAX_REDELIVERIES=5
SOUNDCONNECT_MAIL_RETRY_DELAYS_MS=3000,10000,30000
SOUNDCONNECT_MAIL_USE_RETRY_AFTER=true

# Google identity
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Spotify
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me

# Development bootstrap. Production profile always forces these off.
SOUNDCONNECT_DATA_INIT_ENABLED=true
SOUNDCONNECT_LOCATION_SEED_ENABLED=true
SOUNDCONNECT_BOOTSTRAP_OWNER_ENABLED=false
SOUNDCONNECT_BOOTSTRAP_OWNER_USERNAME=
SOUNDCONNECT_BOOTSTRAP_OWNER_PASSWORD=
SOUNDCONNECT_BOOTSTRAP_OWNER_EMAIL=
SOUNDCONNECT_BOOTSTRAP_OWNER_PHONE=
SOUNDCONNECT_BOOTSTRAP_OWNER_CITY=
SOUNDCONNECT_BOOTSTRAP_OWNER_MIN_PASSWORD_LENGTH=16

# Optional integrations / operations
SOUNDCONNECT_VENUE_APPLICATION_NOTIFY_TO=backstage@soundconnect.com.tr,berkay@soundconnect.com.tr
SOUNDCONNECT_STUDIO_APPLICATION_NOTIFY_TO=backstage@soundconnect.com.tr,berkay@soundconnect.com.tr
SOUNDCONNECT_NOTIFICATION_RETENTION_DAYS=30
SOUNDCONNECT_NOTIFICATION_CLEANUP_CRON=0 20 4 * * *

# Media transcode queues and worker tuning
SOUNDCONNECT_MEDIA_EXCHANGE=media.transcode
SOUNDCONNECT_MEDIA_DLX=media.transcode.dlx
SOUNDCONNECT_MEDIA_VIDEO_HLS_QUEUE=media.transcode.video.hls
SOUNDCONNECT_MEDIA_VIDEO_HLS_DLQ=media.transcode.video.hls.dlq
SOUNDCONNECT_MEDIA_VIDEO_HLS_ROUTING_KEY=video.hls.request
SOUNDCONNECT_MEDIA_VIDEO_HLS_DLQ_ROUTING_KEY=video.hls.request.dlq
SOUNDCONNECT_MEDIA_LISTENER_CONCURRENCY=1
SOUNDCONNECT_MEDIA_TRANSCODE_WORKER_ENABLED=true
SOUNDCONNECT_MEDIA_TRANSCODE_WORKER_THREADS=1
SOUNDCONNECT_MEDIA_PUBLISHER_CONFIRM_TIMEOUT=5s
SOUNDCONNECT_MEDIA_TRANSCODE_SENT_RECOVERY_HOURS=1
SOUNDCONNECT_MEDIA_TRANSCODE_SENT_RECOVERY_INITIAL_DELAY_MS=60000
SOUNDCONNECT_MEDIA_TRANSCODE_SENT_RECOVERY_CHECK_MS=60000
SOUNDCONNECT_TRANSCODE_GOP=48
SOUNDCONNECT_TRANSCODE_PRESET=veryfast
SOUNDCONNECT_TRANSCODE_CRF=21
SOUNDCONNECT_TRANSCODE_CONTAINER=FMP4
SOUNDCONNECT_TRANSCODE_SEGMENT_DURATION_SECONDS=4
# Use executable names when they are on PATH, or absolute paths for native IDE runs.
FFMPEG_BINARY=ffmpeg
FFMPEG_PROCESS_TIMEOUT_SECONDS=3600
SOUNDCONNECT_TRANSCODE_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=7200
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30
SOUNDCONNECT_TRANSCODE_MAX_DURATION_SECONDS=900
SOUNDCONNECT_TRANSCODE_MAX_VIDEO_DIMENSION=3840
SOUNDCONNECT_TRANSCODE_MAX_VIDEO_PIXELS=8294400
SOUNDCONNECT_TRANSCODE_MAX_FRAME_RATE=60.0
SOUNDCONNECT_TRANSCODE_MAX_OUTPUT_BYTES=2147483648
SOUNDCONNECT_TRANSCODE_MAX_TEMP_WORK_BYTES=6442450944
SOUNDCONNECT_TRANSCODE_GLOBAL_TEMP_BUDGET_BYTES=6442450944
# Must equal the hard ephemeral-volume/tmpfs quota in the worker deployment.
SOUNDCONNECT_TRANSCODE_TEMP_VOLUME_BYTES=6442450944
SOUNDCONNECT_TRANSCODE_TEMP_BUDGET_ACQUIRE_TIMEOUT_SECONDS=300
SOUNDCONNECT_TRANSCODE_MIN_FREE_TEMP_BYTES=536870912
SOUNDCONNECT_TRANSCODE_OUTPUT_ESTIMATE_MULTIPLIER=1.20
SOUNDCONNECT_TRANSCODE_OUTPUT_FIXED_OVERHEAD_BYTES=16777216

# Pulse lifecycle
SOUNDCONNECT_PULSE_TICK_INTERVAL_MS=5000
SOUNDCONNECT_PULSE_ROOM_DURATION_MINUTES=30
SOUNDCONNECT_PULSE_ROOM_COUNT=8
SOUNDCONNECT_PULSE_COOLDOWN_SECONDS=1

# Local observability and API documentation
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING_WEB=DEBUG
LOGGING_LEVEL_SOUNDCONNECT=DEBUG
