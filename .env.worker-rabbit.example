# Contract for the isolated consume-only media worker RabbitMQ identity.
# scripts/dev.ps1 creates .env.worker-rabbit.local with a generated 256-bit secret.
# The bootstrap grants exact HLS queue configure/read and no exchange write access.
SOUNDCONNECT_MEDIA_WORKER_RABBITMQ_USERNAME=soundconnect-media-worker
SOUNDCONNECT_MEDIA_WORKER_RABBITMQ_PASSWORD=replace-with-a-generated-256-bit-secret
